# ATLAS Academy — environment variables
#
# Copy this file to .env and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# Everything prefixed VITE_ is bundled into the JavaScript sent to the browser.
# Never put a secret behind a VITE_ prefix.

# ---------------------------------------------------------------------------
# Client — safe to expose
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "publishable" key. This key is public by design; it identifies
# the project, not the user. Every permission is enforced by Row Level Security
# in the database, so the anon key on its own grants access to nothing.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server only — never expose
# ---------------------------------------------------------------------------

# The service-role key bypasses Row Level Security completely. It is used only
# by Netlify Functions (creating a user, sending an invitation) and must be set
# in the Netlify UI under Site settings → Environment variables — never in a
# committed file, and never with a VITE_ prefix.
#
# SUPABASE_SERVICE_ROLE_KEY=
